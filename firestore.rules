rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '4uP29AKNr9evZLbL1HrsOHGdrQH2' ||
        request.auth.token.email == 'solemouse9650@gmail.com'
      );
    }

    match /site/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /team/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blog/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hours/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reservations/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /clients/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /activity/{id} {
      allow read, write: if isAdmin();
    }
  }
}
