rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'lLuTwK8IAORJNe3UTgtH2VtaUO12'
        && request.auth.token.email == 'ecovetaspotoles@gmail.com';
    }

    function isString(field, minLen, maxLen) {
      return field is string
        && field.size() >= minLen
        && field.size() <= maxLen;
    }

    function looksLikeEmail(value) {
      return value is string
        && value.size() >= 5
        && value.size() <= 120
        && value.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$');
    }

    function validReservation() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'firstName', 'lastName', 'email', 'phone', 'petName', 'species',
          'breed', 'age', 'weight', 'serviceId', 'serviceName', 'date', 'time',
          'veterinarianId', 'veterinarianName', 'notes', 'status',
          'createdAt', 'updatedAt', 'estimatedPrice'
        ])
        && isString(d.firstName, 1, 80)
        && isString(d.lastName, 1, 80)
        && looksLikeEmail(d.email)
        && isString(d.phone, 6, 40)
        && isString(d.petName, 1, 80)
        && isString(d.species, 1, 40)
        && isString(d.breed, 1, 80)
        && isString(d.age, 1, 40)
        && isString(d.weight, 1, 40)
        && isString(d.serviceId, 1, 80)
        && isString(d.serviceName, 1, 120)
        && isString(d.date, 8, 20)
        && isString(d.time, 4, 10)
        && isString(d.veterinarianId, 0, 80)
        && isString(d.veterinarianName, 0, 120)
        && isString(d.notes, 0, 1000)
        && d.status == 'pendiente'
        && isString(d.createdAt, 10, 40)
        && isString(d.updatedAt, 10, 40)
        && d.estimatedPrice is number
        && d.estimatedPrice >= 0
        && d.estimatedPrice < 100000000;
    }

    function validContact() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'name', 'email', 'phone', 'message', 'type', 'createdAt'
        ])
        && isString(d.name, 1, 120)
        && looksLikeEmail(d.email)
        && isString(d.phone, 6, 40)
        && isString(d.message, 5, 2000)
        && d.type == 'contact'
        && isString(d.createdAt, 10, 40);
    }

    match /site/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /team/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blog/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hours/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reservations/{id} {
      allow create: if validReservation();
      allow read, update, delete: if isAdmin();
    }

    match /clients/{id} {
      allow create: if validContact();
      allow read, update, delete: if isAdmin();
    }

    match /activity/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
