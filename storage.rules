rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == '0RWsbSfbtycAnxmaik1wdAz4SRr2'
        && request.auth.token.email == 'ecovetaspotoles@gmail.com';
    }

    function isSafeImage() {
      return request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    match /gallery/{fileName} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin() && isSafeImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
